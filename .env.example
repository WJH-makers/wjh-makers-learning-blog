NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas M0 免费云数据库连接地址。
# 格式来自 Atlas 控制台：Connect -> Drivers -> Node.js。
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/learning_blog?retryWrites=true&w=majority
# 如果某些平台只提供 DATABASE_URL，也可以设置 DATABASE_URL；优先使用 MONGODB_URI。
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-host>/learning_blog?retryWrites=true&w=majority
MONGODB_DB_NAME=learning_blog
MONGODB_COLLECTION=learning_posts

# 网页 /write 写入密钥。不要提交真实值。
BLOG_ADMIN_TOKEN=<set-a-long-random-secret>

# 可选：独立 Judge0 CE 沙箱。未配置时 Java Playground 会诚实显示为不可运行。
# language id 必须对应服务端实际安装的 Java 17 运行时，不要直接照抄其他实例的 ID。
JAVA_JUDGE0_URL=https://<your-judge0-host>
JAVA_JUDGE0_LANGUAGE_ID=<java-17-language-id>
# 托管 Judge0 使用；自托管且入口已受网络策略保护时可留空。
# JAVA_JUDGE0_TOKEN=<runner-auth-token>

# txcloud 拉取式发布完成后用于失效 Cloudflare 缓存；只写入服务器 .env。
# CLOUDFLARE_TOKEN=<cache-purge-api-token>
# CLOUDFLARE_ZONE_ID=<zone-id>

# Cloudflare R2 public custom domain for immutable article assets.
# The bucket must be explicitly connected to this custom domain in Cloudflare;
# do not use an r2.dev URL for production traffic.
R2_PUBLIC_URL=
# Production example: R2_PUBLIC_URL=https://assets.example.com

# Server-side R2 S3 connection. These values never belong in NEXT_PUBLIC_*.
# region is fixed to auto by the asset sync helper and is not an env variable.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET=blog-assets
R2_ACCESS_KEY_ID=<r2-s3-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-s3-secret-access-key>

# Optional Cloudflare API token for independent administrative tooling.
# The blog's S3 asset path does not use this value.
# R2_API_TOKEN=<cloudflare-r2-api-token>

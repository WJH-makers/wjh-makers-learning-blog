[Unit]
Description=Deploy the tested blog production ref on txcloud
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/blog
ExecStartPre=/usr/bin/install -d -m 700 /home/ubuntu/.local/state/wjh-blog-deploy
ExecStart=/usr/bin/flock -n /home/ubuntu/.local/state/wjh-blog-deploy/deploy.lock /bin/bash /home/ubuntu/blog/scripts/deploy-from-origin.sh
NoNewPrivileges=true
PrivateTmp=true
